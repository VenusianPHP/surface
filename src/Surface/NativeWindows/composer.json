{
    "name": "surface/native-windows",
    "description": "Surface native OS windows: windows, menu profiles, conjured views and components over the OS bridge.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "psr/container": "^1.1.1 || ^2.0.1",
        "surface/bridge": "^0.8.0",
        "surface/contracts": "^0.8.0",
        "surface/drawing": "^0.8.0",
        "venusian-voyager/contracts": "^0.8.0",
        "venusian-voyager/magic-aliases": "^0.8.0",
        "venusian-voyager/nuts-and-bolts": "^0.8.0"
    },
    "suggest": {
        "jovian/venusian-appkit": "^0.8.0 - To build apps that use MacOS Windows using AppKit",
        "jovian/venusian-gtk": "^0.8.0 - To build apps that use Linux Windows using GTK."
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Surface\\NativeWindows\\": ""
        },
        "files": [
            "Helpers/os.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.8.x-dev"
        },
        "venusian": {
            "providers": [
                "Surface\\NativeWindows\\NativeWindowsServiceProvider"
            ],
            "aliases": {
                "NativeWindow": "Surface\\NativeWindows\\MagicAliases\\NativeWindow"
            }
        }
    }
}
