{
    "name": "venusian-surface/text",
    "description": "Surface text: fonts found through fontconfig, FreeType faces and glyph masks, and HarfBuzz shaping.",
    "keywords": [
        "venusian",
        "surface",
        "text",
        "fonts",
        "shaping"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/venusian/surface/0.11.x/text",
    "support": {
        "issues": "https://github.com/VenusianPHP/surface/issues",
        "source": "https://github.com/venusian-surface/text"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "venusian-surface/contracts": "^0.11.0",
        "venusian-voyager/contracts": "^0.11.0",
        "venusian-voyager/nuts-and-bolts": "^0.11.0"
    },
    "suggest": {
        "ext-fontconfig": "Find fonts and per-character fallbacks.",
        "ext-freetype": "Font metrics and grey glyph coverage.",
        "ext-harfbuzz": "Shaping: kerning, ligatures, complex scripts."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Surface\\Text\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "providers": [
                "Surface\\Text\\TextServiceProvider"
            ]
        }
    }
}
