{
    "name": "surface/bridge",
    "description": "The Surface OS bridge: connect, disconnect and pump the engine session behind the mac.bridge / linux.bridge alias.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "psr/container": "^1.1.1 || ^2.0.1",
        "surface/contracts": "^0.8.0",
        "venusian-voyager/contracts": "^0.8.0",
        "venusian-voyager/magic-aliases": "^0.8.0",
        "venusian-voyager/nuts-and-bolts": "^0.8.0"
    },
    "suggest": {
        "jovian/venusian-appkit": "^0.8.0 - To build apps that use MacOS Windows using AppKit",
        "jovian/venusian-gtk": "^0.8.0 - To build apps that use Linux Windows using GTK."
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Surface\\Bridge\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        },
        "venusian": {
            "providers": [
                "Surface\\Bridge\\BridgeServiceProvider"
            ],
            "aliases": {
                "OSAppBridge": "Surface\\Bridge\\MagicAliases\\OSAppBridge"
            }
        }
    }
}
