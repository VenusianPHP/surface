{
    "name": "venusian-surface/fonts",
    "description": "Surface fonts: bitmap faces (GFXFont) and TrueType faces through ext-only drivers.",
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/venusian/surface/0.11.x/fonts",
    "support": {
        "issues": "https://github.com/VenusianPHP/surface/issues",
        "source": "https://github.com/venusian-surface/fonts"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "venusian-surface/contracts": "^0.11.0",
        "venusian-voyager/console": "^0.11.0",
        "venusian-voyager/contracts": "^0.11.0",
        "venusian-voyager/filesystem": "^0.11.0",
        "venusian-voyager/nuts-and-bolts": "^0.11.0"
    },
    "suggest": {
        "ext-fontconfig": "*",
        "ext-freetype": "*",
        "ext-harfbuzz": "*"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Surface\\Fonts\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "providers": [
                "Surface\\Fonts\\FontsServiceProvider"
            ]
        }
    }
}
