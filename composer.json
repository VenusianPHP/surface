{
    "name": "venusian/surface",
    "description": "The Venusian Display Panel Framework.",
    "keywords": [
        "framework",
        "venusian",
        "scrapyard-io",
        "display",
        "framebuffer"
    ],
    "license": "MIT",
    "version": "0.10.0",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/venusian/surface/0.10.x",
    "support": {
        "issues": "https://github.com/VenusianPHP/surface/issues",
        "source": "https://github.com/VenusianPHP/surface"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "venusian-voyager/console": "^0.10.1",
        "venusian-voyager/filesystem": "^0.10.1",
        "venusian-voyager/io-pools": "^0.10.1",
        "venusian-voyager/nuts-and-bolts": "^0.10.1"
    },
    "replace": {
        "venusian-surface/bridge": "self.version",
        "venusian-surface/canvas": "self.version",
        "venusian-surface/contracts": "self.version",
        "venusian-surface/drawing": "self.version",
        "venusian-surface/embedded-displays": "self.version",
        "venusian-surface/fonts": "self.version",
        "venusian-surface/framebuffers": "self.version",
        "venusian-surface/human-input": "self.version",
        "venusian-surface/stage": "self.version",
        "venusian-surface/windows": "self.version"
    },
    "suggest": {},
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Surface\\": "src/Surface"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Venusian\\Surface\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "providers": [
                "Surface\\Core\\Providers\\SurfaceServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
